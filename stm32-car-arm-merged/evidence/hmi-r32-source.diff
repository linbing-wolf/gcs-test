+    send_line("runimu A");screen_snapshot(&s);CHECK(s.value[HMI_PHASE]==1);
+    for(i=1;i<8;i++) {run.job=(uint8_t)i;screen_snapshot(&s);CHECK(s.value[HMI_PHASE]==(int32_t)i+1);}
