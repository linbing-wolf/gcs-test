# Windows 系统文件
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# macOS
.DS_Store

# 编辑器/IDE
.vscode/
.idea/
*.swp
*.swo

# 临时文件
*.tmp
*.bak
.backup/

# 百度网盘上传残留配置（非大赛材料）
*.baiduyun.uploading.cfg

# 日志
*.log

# 操作系统临时目录
Temp/
temp/

# 参考开源仓库（第三方代码，仅本地参考，不推送到 gcs-test）
参考开源/

# 当前目录还有其他本地项目；本轮仅纳入程序和原有资料。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/stm32-car-test/
!/stm32-car-arm-merged/
!/test-code/
!/文档/
!/附件/
!/vision-maixcam/

# 本地凭据不入库（只按文件名忽略）。
.env
.env.*
auth.json
*.pem
*.key

# 本地运行产物与 IDE 界面状态。
*.exe
__pycache__/
*.pyc
/stm32-car-test/keil/*.uvguix.*
/stm32-car-test/keil/OBJ/*
!/stm32-car-test/keil/OBJ/table_navigation.axf
!/stm32-car-test/keil/OBJ/table_navigation.hex
!/stm32-car-test/keil/OBJ/table_navigation.map
/stm32-car-test/evidence/native-*/
/stm32-car-test/evidence/heading-native-*/
/stm32-car-test/evidence/map-native-*/

# 清单中的历史验证日志随程序交接；临时运行目录仍按上方规则忽略。
!/stm32-car-test/evidence/**/*.log

# 独立底盘与机械机构合并工程：保留交付固件/证据，忽略本地运行产物。
/stm32-car-arm-merged/keil/*.uvguix.*
/stm32-car-arm-merged/keil/OBJ/*
!/stm32-car-arm-merged/keil/OBJ/table_navigation.axf
!/stm32-car-arm-merged/keil/OBJ/table_navigation.hex
!/stm32-car-arm-merged/keil/OBJ/table_navigation.map
/stm32-car-arm-merged/evidence/**/*.o
!/stm32-car-arm-merged/evidence/**/*.log
